{
  "dest.table": "ta.indices",
  "dest.table.primary.keys": ["Timeframe", "Symbol", "Datetime"],
  "symbol.src.table": "indices",
  "symbol.src.table.column.filter": {
    "Symbol" : "NIFTY 50",
    "Timeframe": "1m"
  },
  "symbol.src.table.column.select": "Symbol",
  "symbol.data.table": "indices",
  "symbol.data.table.column.filter": {},
  "symbol.data.column.orderby": "\"Datetime\" desc",
  "symbol.data.limit" : 1200,
  "period": 10,
  "ohlcv.column.mapping": {
    "Open": "HA_Open",
    "High": "HA_High",
    "Low": "HA_Low",
    "Close": "HA_Close"
  }
}
